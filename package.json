{
  "name": "gpa-program",
  "version": "1.0.0",
  "description": "I wanted to make a program similar to GradeWay to do what-ifs with my grades since GradeWay is subscription-based.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "test": "echo \"Error: no test specified\" && exit 1",
    "package": "electron-packager . GradeMenu --platform=win32 --arch=x64 --out=../GradeMenu-release --overwrite"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KohiFish/GPA-Program.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/KohiFish/GPA-Program/issues"
  },
  "homepage": "https://github.com/KohiFish/GPA-Program#readme",
  "build": {
    "appId": "com.kohifish.gpaprogram",
    "productName": "Grade Menu",
    "files": [
      "main.js",
      "hac.js",
      "index.html",
      "district.json",
      "icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@electron/packager": "^0.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^20.23.1"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  }
}
